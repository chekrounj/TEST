# Renomme ce fichier en .env et remplis les valeurs

# Google OAuth — obtenu sur https://console.cloud.google.com/apis/credentials
# (créer un OAuth Client ID type "Web application", ajouter http://localhost:3000
#  dans Authorized JavaScript origins)
GOOGLE_CLIENT_ID=

# Long mot de passe aléatoire pour signer les JWT applicatifs
# Génère-en un avec : node -e "console.log(crypto.randomBytes(48).toString('base64'))"
JWT_SECRET=

# Port du serveur (défaut 3000)
PORT=3000

# Active le login de dev (POST /api/auth/dev) — pratique avant d'avoir
# configuré Google. À DÉSACTIVER en production.
ALLOW_DEV_LOGIN=1

# Optionnel : où sert-on cashflow.html (relatif à backend/server.js).
# Par défaut : ../  (le repo parent où vit cashflow.html)
# STATIC_DIR=..
