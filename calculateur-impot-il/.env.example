# Microsoft App Registration (Graph API — envoi email authentifié)
VITE_AZURE_CLIENT_ID=
# Bank of Israel (taux de change officiels — שערים יציגים)
VITE_BOI_API_BASE=https://boi.org.il
# exchangerate.host (fallback gratuit, sans clé API)
VITE_EXCHANGERATE_API_BASE=https://api.exchangerate.host
# Hebcal (jours fériés / fêtes juives)
VITE_HEBCAL_API_BASE=https://www.hebcal.com
# Locale par défaut (fr | he | en)
VITE_DEFAULT_LOCALE=fr
# Activer l'intégration Microsoft 365
VITE_ENABLE_M365=true
# Analytics optionnel (Plausible, etc.)
VITE_ANALYTICS_ID=
